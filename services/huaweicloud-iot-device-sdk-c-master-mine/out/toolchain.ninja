rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}
rule cxx
  command = g++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule alink
  command = rm -f ${out} && ar rcs ${out} ${in}
  description = AR ${target_output_name}${output_extension}
rule link
  command = g++ ${ldflags} -o ${target_output_name}${output_extension} -Wl,--start-group @${target_output_name}${output_extension}.rsp ${solibs} -Wl,--end-group ${libs}
  description = LINK ${target_output_name}${output_extension}
  rspfile = ${target_output_name}${output_extension}.rsp
  rspfile_content = ${in}
rule solink
  command = g++ -shared ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = ${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule cc
  command = gcc -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc

build conf: copy ../conf

build obj/conf_copy.stamp: stamp conf
build lib: copy ../lib

build obj/lib_copy.stamp: stamp lib
subninja obj/mqtt_device_demo.ninja
subninja obj/src/dconncaseone_interface.ninja
subninja obj/src/agentlite/agentlite.ninja
subninja obj/src/base/base.ninja
subninja obj/src/device_demo/device_demo.ninja
subninja obj/src/service/service.ninja
subninja obj/src/service/bridge/bridge_topic.ninja
subninja obj/src/service/detect_anomaly/detect_anomaly.ninja
subninja obj/src/service/device_rule/device_rule.ninja
subninja obj/src/service/sys_hal/sys_hal.ninja
subninja obj/src/third_party/cjson/cjson.ninja
subninja obj/src/tunnel/tunnel.ninja
subninja obj/src/util/util.ninja
