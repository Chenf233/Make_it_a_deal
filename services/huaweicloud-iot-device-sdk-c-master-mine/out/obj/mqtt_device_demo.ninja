defines = -DSSH_SWITCH\$ =\$ 1 -DBRIDGE_SWITCH\$ =\$ 1
include_dirs =
target_out_dir = obj
target_output_name = MQTT_Demo

build obj/mqtt_device_demo.inputdeps.stamp: stamp obj/conf_copy.stamp obj/lib_copy.stamp

build MQTT_Demo: link obj/src/util/libutil.a obj/src/third_party/cjson/libcjson.a obj/src/service/libservice.a obj/src/base/libbase.a obj/src/agentlite/libagentlite.a obj/src/tunnel/libtunnel.a obj/src/service/device_rule/libdevice_rule.a obj/src/service/sys_hal/libsys_hal.a obj/src/service/detect_anomaly/libdetect_anomaly.a obj/src/service/bridge/libbridge_topic.a obj/src/libdconncaseone_interface.a obj/src/device_demo/libdevice_demo.a | ../lib/libboundscheck.so ../lib/libssl.so ../lib/libcrypto.so ../lib/libz.so ../lib/libpaho-mqtt3as.so ../lib/libssh.so ../lib/libnopoll.so ../lib/libcurl.so || obj/conf_copy.stamp obj/lib_copy.stamp
  ldflags = -Wl,-rpath=\$$ORIGIN/ -Wl,-rpath-link=
  libs = ../lib/libboundscheck.so ../lib/libssl.so ../lib/libcrypto.so ../lib/libz.so ../lib/libpaho-mqtt3as.so ../lib/libssh.so ../lib/libnopoll.so ../lib/libcurl.so -lpthread
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
