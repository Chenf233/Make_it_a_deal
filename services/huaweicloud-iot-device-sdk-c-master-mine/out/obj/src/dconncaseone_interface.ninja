defines = -DSSH_SWITCH\$ =\$ 1 -DBRIDGE_SWITCH\$ =\$ 1
include_dirs = -I../include/util -I../include/third_party/libboundscheck -I../include/third_party/cjson -I../include/third_party/zlib -I../include
cflags = -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-parameter -fPIC -pthread -w
cflags_c =
target_out_dir = obj/src
target_output_name = libdconncaseone_interface

build obj/src/libdconncaseone_interface.dconncaseone_interface.o: cc ../src/dconncaseone_interface.c

build obj/src/libdconncaseone_interface.a: alink obj/src/libdconncaseone_interface.dconncaseone_interface.o
  arflags =
  output_extension = .a
  output_dir = 
