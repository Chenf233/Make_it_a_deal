defines = -DSSH_SWITCH\$ =\$ 1 -DBRIDGE_SWITCH\$ =\$ 1
include_dirs = -I../include -I../include/protocol -I../include/util -I../include/agentlite -I../include/base -I../include/service -I../include/third_party/cjson -I../include/nopoll -I../include/third_party/libboundscheck -I../include/service/device_rule -I../include/tunnel
cflags = -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-parameter -fPIC -pthread -w
cflags_c =
target_out_dir = obj/src/device_demo
target_output_name = libdevice_demo

build obj/src/device_demo/libdevice_demo.device_demo.o: cc ../src/device_demo/device_demo.c

build obj/src/device_demo/libdevice_demo.a: alink obj/src/device_demo/libdevice_demo.device_demo.o
  arflags =
  output_extension = .a
  output_dir = 
