defines = -DSSH_SWITCH\$ =\$ 1 -DBRIDGE_SWITCH\$ =\$ 1
include_dirs = -I../include/base -I../include/util -I../include/agentlite -I../include/third_party/cjson -I../include/third_party/libboundscheck -I../include
cflags = -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-parameter -fPIC -pthread -w
cflags_c =
target_out_dir = obj/src/base
target_output_name = libbase

build obj/src/base/libbase.hmac_sha256.o: cc ../src/base/hmac_sha256.c
build obj/src/base/libbase.mqtt_base.o: cc ../src/base/mqtt_base.c

build obj/src/base/libbase.a: alink obj/src/base/libbase.hmac_sha256.o obj/src/base/libbase.mqtt_base.o
  arflags =
  output_extension = .a
  output_dir = 
