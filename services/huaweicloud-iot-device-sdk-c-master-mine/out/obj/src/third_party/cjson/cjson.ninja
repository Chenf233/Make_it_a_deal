defines = -DSSH_SWITCH\$ =\$ 1 -DBRIDGE_SWITCH\$ =\$ 1
include_dirs = -I../include/third_party/cjson
cflags = -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-parameter -fPIC -pthread -w
cflags_c =
target_out_dir = obj/src/third_party/cjson
target_output_name = libcjson

build obj/src/third_party/cjson/libcjson.cJSON.o: cc ../src/third_party/cjson/cJSON.c

build obj/src/third_party/cjson/libcjson.a: alink obj/src/third_party/cjson/libcjson.cJSON.o
  arflags =
  output_extension = .a
  output_dir = 
