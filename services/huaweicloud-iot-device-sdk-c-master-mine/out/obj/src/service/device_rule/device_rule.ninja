defines = -DSSH_SWITCH\$ =\$ 1 -DBRIDGE_SWITCH\$ =\$ 1
include_dirs = -I../include/third_party/cjson -I../include/third_party/libboundscheck -I../include/agentlite -I../include/util -I../include/service/device_rule -I../include/base -I../include/service -I../include
cflags = -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-parameter -DEVICE_RULE_ENALBE -DCONFIG_ENALBE_DEVICE_RULE_FILE_STORAGE -fPIC -pthread -w
cflags_c =
target_out_dir = obj/src/service/device_rule
target_output_name = libdevice_rule

build obj/src/service/device_rule/libdevice_rule.rule_action.o: cc ../src/service/device_rule/rule_action.c
build obj/src/service/device_rule/libdevice_rule.rule_condition.o: cc ../src/service/device_rule/rule_condition.c
build obj/src/service/device_rule/libdevice_rule.rule_execution.o: cc ../src/service/device_rule/rule_execution.c
build obj/src/service/device_rule/libdevice_rule.rule_info.o: cc ../src/service/device_rule/rule_info.c
build obj/src/service/device_rule/libdevice_rule.rule_manager.o: cc ../src/service/device_rule/rule_manager.c
build obj/src/service/device_rule/libdevice_rule.rule_parser.o: cc ../src/service/device_rule/rule_parser.c
build obj/src/service/device_rule/libdevice_rule.rule_trans.o: cc ../src/service/device_rule/rule_trans.c
build obj/src/service/device_rule/libdevice_rule.rule_util.o: cc ../src/service/device_rule/rule_util.c

build obj/src/service/device_rule/libdevice_rule.a: alink obj/src/service/device_rule/libdevice_rule.rule_action.o obj/src/service/device_rule/libdevice_rule.rule_condition.o obj/src/service/device_rule/libdevice_rule.rule_execution.o obj/src/service/device_rule/libdevice_rule.rule_info.o obj/src/service/device_rule/libdevice_rule.rule_manager.o obj/src/service/device_rule/libdevice_rule.rule_parser.o obj/src/service/device_rule/libdevice_rule.rule_trans.o obj/src/service/device_rule/libdevice_rule.rule_util.o
  arflags =
  output_extension = .a
  output_dir = 
