defines = -DSSH_SWITCH\$ =\$ 1 -DBRIDGE_SWITCH\$ =\$ 1
include_dirs = -I../include/third_party/cjson -I../include/third_party/libboundscheck -I../include/agentlite -I../include/util -I../include/service -I../include/service/sys_hal -I../include/service/detect_anomaly -I../include
cflags = -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-parameter -fPIC -pthread -w
cflags_c =
target_out_dir = obj/src/service/detect_anomaly
target_output_name = libdetect_anomaly

build obj/src/service/detect_anomaly/libdetect_anomaly.detect_anomaly.o: cc ../src/service/detect_anomaly/detect_anomaly.c
build obj/src/service/detect_anomaly/libdetect_anomaly.report_anomaly.o: cc ../src/service/detect_anomaly/report_anomaly.c

build obj/src/service/detect_anomaly/libdetect_anomaly.a: alink obj/src/service/detect_anomaly/libdetect_anomaly.detect_anomaly.o obj/src/service/detect_anomaly/libdetect_anomaly.report_anomaly.o
  arflags =
  output_extension = .a
  output_dir = 
