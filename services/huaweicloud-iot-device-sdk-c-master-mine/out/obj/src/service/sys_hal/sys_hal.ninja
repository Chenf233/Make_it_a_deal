defines = -DSSH_SWITCH\$ =\$ 1 -DBRIDGE_SWITCH\$ =\$ 1
include_dirs = -I../include/util -I../include/service/sys_hal
cflags = -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-parameter -fPIC -pthread -w
cflags_c =
target_out_dir = obj/src/service/sys_hal
target_output_name = libsys_hal

build obj/src/service/sys_hal/libsys_hal.sys_hal.o: cc ../src/service/sys_hal/sys_hal.c

build obj/src/service/sys_hal/libsys_hal.a: alink obj/src/service/sys_hal/libsys_hal.sys_hal.o
  arflags =
  output_extension = .a
  output_dir = 
